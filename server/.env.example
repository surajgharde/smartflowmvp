# Local development. On Vercel, set these as Project → Settings → Environment Variables.
PORT=5050

# MongoDB. The database name is REQUIRED — a URI ending at the host connects to
# the default "test" database instead, which will look empty.
#   local  mongodb://127.0.0.1:27017/smartflow
#   atlas  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/smartflow?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/smartflow

JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of front-end origins allowed to call the API.
# Not needed when the API and client are served from the same origin.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
